# Frontend: this public key is embedded into the browser build.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional Clerk Frontend API proxy for the Netlify domain.
VITE_CLERK_PROXY_URL=/api/__clerk

# Server-only values: never expose these as VITE_* variables.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
ADMIN_EMAIL=
NETLIFY_PERSONAL_ACCESS_TOKEN=